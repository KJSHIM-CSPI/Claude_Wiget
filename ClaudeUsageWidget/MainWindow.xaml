<Window x:Class="ClaudeUsageWidget.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Claude 사용량 · Claude Code / 브라우저 연결 v0.4.1" Width="360" SizeToContent="Height" ResizeMode="NoResize"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Foreground="{StaticResource Ink}" FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
 <Border Background="#212320" BorderBrush="#4C4C46" BorderThickness="1" CornerRadius="16" Padding="22,16,22,18">
  <StackPanel>
   <Grid Background="Transparent" MouseLeftButtonDown="DragWindow" Margin="0,0,0,22">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="✳" Foreground="{StaticResource Accent}" FontSize="25" Margin="0,0,8,0"/>
     <TextBlock Text="Claude" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
     <TextBlock Text=" / usage 0.4.1" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
    </StackPanel>
    <Button x:Name="PinButton" Grid.Column="1" Content="고정" Click="TogglePin" Padding="8,6" Margin="0,0,5,0" ToolTip="항상 위에 표시 전환"/>
    <Button Grid.Column="2" Content="×" Click="CloseWidget" Padding="8,4" FontSize="18" ToolTip="위젯 종료"/>
   </Grid>
   <Grid Margin="0,0,0,10">
    <TextBlock Text="5시간 사용량" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
    <TextBlock x:Name="FivePercent" Text="—" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right"/>
   </Grid>
   <ProgressBar x:Name="FiveProgress"/>
   <Border Background="#2B2E29" CornerRadius="10" Padding="14,12" Margin="0,17,0,21">
    <StackPanel>
     <TextBlock Text="초기화까지" Foreground="{StaticResource Muted}" FontSize="11"/>
     <TextBlock x:Name="Countdown" Text="시간 정보 없음" FontFamily="Consolas, Malgun Gothic" FontSize="27" Margin="0,5,0,0"/>
     <TextBlock x:Name="ResetTime" Text="로그인 후 확인할 수 있습니다." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
    </StackPanel>
   </Border>
   <Grid Margin="0,0,0,10">
    <TextBlock Text="Fable 사용량" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
    <TextBlock x:Name="FablePercent" Text="—" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right"/>
   </Grid>
   <ProgressBar x:Name="FableProgress" Foreground="#A7B89A"/>
   <TextBlock x:Name="FableInfo" Text="계정에서 제공하는 한도를 표시합니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,17" TextWrapping="Wrap"/>
   <Border Height="1" Background="#3C3E38" Margin="0,0,0,12"/>
   <TextBlock x:Name="Status" Text="연결하면 Claude Code 인증을 먼저 확인합니다." FontSize="12" TextWrapping="Wrap"/>
   <TextBlock x:Name="Updated" Text="아직 조회하지 않았습니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,12" TextWrapping="Wrap"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button Content="연결" Click="OpenLogin" Margin="0,0,6,0" Padding="5,8"/>
    <Button x:Name="RefreshButton" Grid.Column="1" Content="새로고침" Click="RefreshNow" Margin="0,0,6,0"/>
    <Button Grid.Column="2" Content="설정" Click="OpenSettings"/>
   </Grid>
  </StackPanel>
 </Border>
</Window>
