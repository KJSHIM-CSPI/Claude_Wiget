<Window x:Class="ClaudeUsageWidget.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="위젯 설정" Width="420" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="#212320" FontFamily="Segoe UI, Malgun Gothic">
 <StackPanel Margin="24">
  <TextBlock Text="위젯 설정" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
  <TextBlock Text="갱신 주기 (초)" Margin="0,0,0,6"/>
  <TextBox x:Name="IntervalInput"/>
  <TextBlock Text="기본 30초 · 10초부터 86,400초까지" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,14"/>
  <Grid><TextBlock Text="투명도"/><TextBlock x:Name="OpacityLabel" HorizontalAlignment="Right"/></Grid>
  <Slider x:Name="TransparencyInput" Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PreviewTransparency" Margin="0,10,0,4"/>
  <TextBlock Text="0%는 불투명, 80%는 가장 투명합니다." Foreground="{StaticResource Muted}" FontSize="11"/>
  <CheckBox x:Name="TopmostInput" Content="항상 위에 표시" Margin="0,16,0,16"/>
  <Border Height="1" Background="#45473F" Margin="0,0,0,10"/>
  <CheckBox x:Name="ManualInput" Content="사용량 직접 입력 (자동 조회 일시 중지)" Checked="ManualChanged" Unchecked="ManualChanged"/>
  <StackPanel x:Name="ManualFields" Margin="0,6,0,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="5시간 사용률 (%)" Margin="0,0,0,6"/><TextBox x:Name="FiveInput"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Fable 사용률 (%)" Margin="0,0,0,6"/><TextBox x:Name="FableInput"/></StackPanel>
   </Grid>
   <TextBlock Text="5시간 한도 초기화 시각 (PC 현지 시각)" Margin="0,14,0,6"/>
   <TextBox x:Name="ResetInput" ToolTip="예: 2026-09-23 18:30"/>
   <TextBlock Text="yyyy-MM-dd HH:mm 형식입니다. 비워 두어도 됩니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
  </StackPanel>
  <TextBlock x:Name="ErrorText" Foreground="#FFAD98" TextWrapping="Wrap" Margin="0,14,0,6"/>
  <Grid Margin="0,8,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="LogoutButton" Content="연결 해제" Click="Logout" HorizontalAlignment="Left" ToolTip="위젯 인증을 삭제하고 자동 연결을 중지합니다. Claude Code 로그인은 유지됩니다."/>
   <Button Grid.Column="1" Content="취소" Click="Cancel" Margin="0,0,8,0" IsCancel="True"/>
   <Button Grid.Column="2" Content="저장" Click="Save" Background="#765240" IsDefault="True"/>
  </Grid>
 </StackPanel>
</Window>
