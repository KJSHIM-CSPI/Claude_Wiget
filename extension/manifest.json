{
  "manifest_version": 3,
  "name": "Claude 사용량 위젯 연결",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "선택한 Claude 탭의 사용량과 초기화 시각을 이 PC의 위젯에 전달합니다.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "storage", "alarms"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html"}
}
